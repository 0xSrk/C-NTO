{
  "name": "canto",
  "productName": "CΛNTO",
  "version": "0.1.0",
  "description": "CΛNTO — desk de trading local (Nasdaq / CME futures) forgé par SIΞRRΛSKΛ",
  "private": true,
  "author": "SIΞRRΛSKΛ",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "desk:dev": "npm run electron:compile && concurrently -k -n vite,desk -c cyan,white \"vite --strictPort\" \"cross-env CANTO_DEV_URL=http://localhost:5173 electron .\"",
    "desk:build": "npm run build && npm run electron:compile",
    "dist": "npm run desk:build && electron-builder",
    "dist:win": "npm run desk:build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.15",
    "lightweight-charts": "^5.2.1",
    "marked": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.16.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "lab.sierraska.canto",
    "productName": "CΛNTO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "CANTO-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CΛNTO"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  }
}
