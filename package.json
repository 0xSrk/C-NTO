{
  "name": "canto",
  "productName": "CΛNTO",
  "version": "2.0.2",
  "description": "CΛNTO — desk de trading local Nasdaq / CME · SIΞRRΛSKΛ Lab v2.0.2 · macOS, Windows, Linux",
  "private": true,
  "author": "SIΞRRΛSKΛ",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.js",
  "desktopName": "canto.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "hash-release": "node scripts/hash-release.mjs",
    "calendar:snapshot": "node scripts/calendar-snapshot.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.sources.json && node scripts/copy-electron-assets.mjs",
    "launch": "node scripts/launch.mjs",
    "desk:dev": "npm run electron:compile && concurrently -k -n vite,desk -c cyan,white \"vite --strictPort\" \"cross-env CANTO_DEV_URL=http://localhost:5173 electron .\"",
    "desk:build": "npm run build && npm run electron:compile",
    "dist": "npm run desk:build && electron-builder --publish never",
    "dist:win": "npm run desk:build && electron-builder --win --x64 --arm64 --publish never",
    "dist:mac": "npm run desk:build && electron-builder --mac --universal --publish never",
    "dist:linux": "npm run desk:build && electron-builder --linux --x64 --arm64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.15",
    "lightweight-charts": "^5.2.1",
    "marked": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.7.1",
    "electron-builder": "^26.16.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "lab.sierraska.canto",
    "productName": "CΛNTO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "build/icon.png",
      "build/logo.svg",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "ninjatrader/CantoBridge.cs",
        "to": "ninjatrader/CantoBridge.cs"
      },
      {
        "from": "docs/PONT-NINJATRADER.md",
        "to": "ninjatrader/PONT-NINJATRADER.md"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CANTO-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CΛNTO",
      "artifactName": "CANTO-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "CANTO-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "canto",
      "syncDesktopName": true,
      "synopsis": "Desk de trading local Nasdaq / CME",
      "category": "Finance",
      "maintainer": "SIΞRRΛSKΛ Lab <canto@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CANTO-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "CANTO-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "CΛNTO ${version}"
    }
  }
}
