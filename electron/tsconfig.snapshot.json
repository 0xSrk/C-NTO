{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../.cache/calendar-snapshot",
    "rootDir": ".",
    "types": ["node"],
    "sourceMap": false
  },
  "files": [
    "locale.ts",
    "calendar/dates.ts",
    "calendar/types.ts",
    "calendar/bls.ts",
    "calendar/bea.ts",
    "calendar/fed.ts",
    "calendar/ecb.ts",
    "calendar/eia.ts",
    "calendar/treasury.ts"
  ]
}
