{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist-electron",
    "rootDir": "../src/engine",
    "sourceMap": false,
    "types": ["node"]
  },
  "files": [
    "../src/engine/sources.ts",
    "../src/engine/execution/guards.ts",
    "../src/engine/execution/orderBook.ts",
    "../src/engine/copier/router.ts",
    "../src/engine/copier/position.ts",
    "../src/engine/copier/sync.ts",
    "../src/engine/agent/catalog.ts",
    "../src/engine/agent/orders.ts",
    "../src/engine/agent/routines.ts",
    "../src/engine/crypto/markets.ts",
    "../src/engine/crypto/venues.ts",
    "../src/engine/crypto/tradeBars.ts",
    "../src/engine/crypto/temperature.ts"
  ]
}
